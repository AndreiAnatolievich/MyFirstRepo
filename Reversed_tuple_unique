def reverse_tuple(tup):
    # Переворачиваем элементы
    reversed_tup = reversed(tup)
    # Удаляем дубликаты, сохраняя порядок
    seen = set()
    unique_items = []
    for item in reversed_tup:
        if item not in seen:
            seen.add(item)
            unique_items.append(item)
    return tuple(unique_items)

