def calculator(op, a, b):
    operator = ('+', '-', '*', '/', '%', '**', '^')
    if op in operator:
        if op == '+':
            return a + b
        elif op == '-':
            return a - b
        elif op == '*':
            return a * b
        elif op == '/':
            if b == 0:
                return 'Error'
            return a / b
        elif op == '%':
            return a % b
        elif op == '**':
            return a ** b
        elif op == '^':
            return a ** b
        else:
            return 'Error'
    else:
        return 'Error'
